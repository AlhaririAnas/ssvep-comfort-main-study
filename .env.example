# Copy this file to .env and fill in your own values.
# Never commit .env with real credentials.

# Emotiv Cortex credentials
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=

# Project paths
BCI_DATA_DIR=data
BCI_CONFIG_DIR=configs
BCI_STIMULI_JSON=configs/stimuli.json

# Participant defaults
BCI_PROBAND_ID=P01
BCI_HEADSET_ID=

# Display defaults
BCI_SCREEN_ID=1
BCI_FULLSCREEN=true
BCI_MONITOR_NAME=bci_monitor
BCI_MONITOR_REFRESH_RATE=60.0
BCI_SCREEN_WIDTH_PX=1920
BCI_SCREEN_HEIGHT_PX=1080
BCI_SCREEN_WIDTH_CM=80.0
BCI_VIEWING_DISTANCE_CM=60.0

# Acquisition defaults
BCI_ACQUISITION_MODE=record
BCI_LIVE_STREAMS=eeg,mot,pow,dev
BCI_LIVE_FLUSH_EVERY=25

